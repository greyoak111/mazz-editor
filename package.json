{
  "name": "mazz-editor",
  "productName": "Mazz Editor",
  "version": "0.2.0",
  "description": "榨干 Electron 的一站式超级编辑器 —— 文档/代码/创作 全闭环",
  "author": "Mazz Editor contributors",
  "main": "main/main.js",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js && node scripts/build-sample-plugins.js",
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "test": "node tests/run.js",
    "test:w94a:capability": "node tests/contract/w94a-capability-execution-spine.test.mjs",
    "test:w94a:runtime": "node tests/e2e/w94a-capability-execution-runtime.mjs",
    "test:w94b:calc-chart": "node tests/contract/w94b-calc-chart-artifact.test.mjs",
    "test:w94b:runtime": "node tests/e2e/w94b-calc-chart-runtime.mjs",
    "test:w94c:canvas": "node --test tests/contract/w94c-canvas-agent.test.mjs",
    "test:w94c:runtime": "node tests/e2e/w94c-canvas-runtime.mjs",
    "test:w94d:blender": "node --test tests/contract/w94d-blender-capability.test.mjs",
    "test:w94d:runtime": "node tests/e2e/w94d-blender-runtime.mjs",
    "test:w94e:relation-branch": "node --test tests/contract/w94e-relation-branch.test.mjs",
    "test:w94e:runtime": "node tests/e2e/w94e-relation-branch-runtime.mjs",
    "test:w93b:library": "node tests/contract/w93b-acquisition-core.test.mjs && node tests/contract/w93b-path-promotion.test.mjs && node tests/contract/w93b-browser-acquisition-bridge.test.mjs && node tests/contract/w93b-inbox-saga.test.mjs && node tests/contract/w93b-runtime-ipc.test.mjs",
    "test:w93b:runtime": "node tests/e2e/w93b-library-acquisition-runtime.mjs",
    "test:w93c:library": "node tests/contract/w93c-rights-source-adapter.test.mjs",
    "test:w93c:runtime": "node tests/e2e/w93c-library-source-runtime.mjs",
    "test:w93d:library": "node tests/contract/w93d-library-source-pack.test.mjs",
    "test:w93d:runtime": "node tests/e2e/w93d-library-source-runtime.mjs",
    "test:w93e:library": "node tests/contract/w93e-library-resource-surface.test.mjs",
    "test:w93e:runtime": "node tests/e2e/w93e-library-resource-runtime.mjs",
    "test:w93f:library": "node tests/contract/w93f-torrent-book-transport.test.mjs",
    "test:w93f:runtime": "node tests/e2e/w93f-library-torrent-runtime.mjs",
    "test:w93g:library": "node tests/contract/w93g-library-convergence.test.mjs",
    "test:w93g:runtime": "node tests/e2e/w93g-library-convergence-runtime.mjs",
    "smoke": "node tests/e2e/smoke.js",
    "dist": "node scripts/build.js && electron-builder",
    "dist:dir": "node scripts/build.js && electron-builder --dir --win",
    "audit:release": "node scripts/release-audit.js --out docs/engineering/evidence/W71_RELEASE_BASELINE.json",
    "audit:provenance": "node scripts/oss-provenance-ledger.js --check .mazz/audit/oss-provenance-ledger.json",
    "audit:provenance:update": "node scripts/oss-provenance-ledger.js --out .mazz/audit/oss-provenance-ledger.json",
    "audit:secrets": "node scripts/secret-audit.js --out docs/engineering/evidence/W71_SECRET_AUDIT.json",
    "audit:w71:census": "node scripts/w71-census.js",
    "audit:w71:native": "node scripts/w71-native-audit.js --out .mazz/audit/native-binary-census.json",
    "test:w71:native-stage": "node scripts/w71-native-stage-verify.js",
    "test:w71:security-ui": "node tests/e2e/w71-security-settings.mjs",
    "test:w71:plugin-trust": "node tests/e2e/w71-plugin-trust.mjs",
    "test:w71:overlay": "node tests/e2e/w71-overlay-zorder.mjs",
    "test:w87:ui": "node scripts/build.js && node tests/e2e/w87-ui-convergence.mjs",
    "test:w87:ui-sweep": "node tests/e2e/ui-page-sweep.mjs",
    "test:w87:theme-legibility": "node tests/e2e/w87g-theme-legibility.mjs",
    "test:w87i:state": "node scripts/build.js && node tests/e2e/w87i-ui-state-convergence.mjs",
    "test:w87i:dock": "node scripts/build.js && node tests/e2e/w87i-pane-dock-continuity.mjs",
    "test:w71:ffmpeg": "node tests/e2e/w71-ffmpeg-runtime.mjs",
    "test:w71:installer": "node tests/e2e/w71-installer-cycle.mjs",
    "test:w71:factory-faults": "node tests/e2e/w71-factory-faults.mjs",
    "test:w71:media-runtime": "node tests/e2e/w71-media-runtime.mjs",
    "test:w71:dap-runtime": "node tests/e2e/w71-dap-runtime.mjs",
    "test:w71:file-change": "node tests/e2e/w71-file-change-runtime.mjs",
    "test:w71:multiwindow-file-change": "node tests/e2e/w71-multiwindow-file-change.mjs",
    "test:w71:window-handoff": "node tests/e2e/w71-window-handoff-runtime.mjs",
    "test:w71:child-crash-recovery": "node tests/e2e/w71-child-crash-recovery.mjs",
    "test:w71:app-crash-recovery": "node tests/e2e/w71-app-crash-recovery.mjs",
    "test:w71:multiwindow-app-crash": "node tests/e2e/w71-multiwindow-app-crash-recovery.mjs",
    "test:w71:core-module-crash": "node tests/e2e/w71-core-module-crash-recovery.mjs",
    "test:w71:file-open": "node tests/e2e/w71-file-open-safety.mjs",
    "test:w71:product-maturity": "node tests/e2e/w71-product-maturity.mjs",
    "test:w92:factory": "node scripts/build.js && node tests/e2e/w92-factory-workflow.mjs",
    "test:w92:factory:release": "npm run dist:dir && node tests/e2e/w92-factory-release.mjs",
    "test:w92:factory:live": "node scripts/build.js && node tests/e2e/w92-factory-live-provider.mjs && node tests/e2e/w92-factory-live-workflow.mjs",
    "test:w92:factory:live-release": "npm run dist:dir && node tests/e2e/w92-factory-live-release.mjs",
    "test:w90:catalog": "node scripts/build.js && node tests/e2e/w90-catalog-thumbnails.mjs",
    "test:w91:audio-artwork": "node scripts/build.js && node tests/e2e/w91-audio-artwork.mjs",
    "test:w67:memory-runtime": "node tests/e2e/w67-memory-runtime.mjs",
    "test:w71:formal-main-paths": "node tests/e2e/w71-formal-main-paths.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.mazz.editor",
    "productName": "Mazz Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/",
      "docs/engineering/doctrine/",
      "preload/",
      "renderer/",
      "!renderer/vendor/ffmpeg/ffmpeg-core.js",
      "!renderer/vendor/ffmpeg/ffmpeg-core.wasm",
      "!renderer/dist/**/*.map",
      "!renderer/vendor/**/*.map",
      "!node_modules/**/*.map",
      "!node_modules/**/prebuilds/darwin-*/**",
      "!node_modules/**/prebuilds/linux-*/**",
      "!node_modules/**/prebuilds/android-*/**",
      "!node_modules/**/prebuilds/win32-ia32/**",
      "!node_modules/**/prebuilds/win32-arm64/**",
      "resources/",
      "package.json",
      "samples/",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "KNOWN_LIMITATIONS.md"
    ],
    "asarUnpack": [
      "node_modules/**/*.node",
      "resources/tools/blender/**"
    ],
    "protocols": [
      {
        "name": "mazz",
        "schemes": [
          "mazz"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "com.mazz.editor.markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "com.mazz.editor.markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "com.mazz.editor.text",
        "description": "Text Document",
        "role": "Editor"
      },
      {
        "ext": "mazz",
        "name": "com.mazz.editor.workspace",
        "description": "Mazz Workspace File",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/app.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "resources/icons/app.ico",
      "uninstallerIcon": "resources/icons/app.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icons/app.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "resources/icons/app.png"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.3",
    "chokidar": "^3.6.0",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fix-webm-duration": "^1.0.6",
    "jszip": "^3.10.1",
    "libass-wasm": "^4.1.0",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.55.1",
    "node-forge": "^1.4.0",
    "node-pty": "^1.1.0",
    "perfect-freehand": "^1.2.3",
    "pptxgenjs": "^4.0.1",
    "prosemirror-tables": "^1.8.5",
    "qrcode": "^1.5.4",
    "saxes": "5.0.1",
    "tesseract.js": "^7.0.0",
    "webtorrent": "2.8.5",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.3"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "markdown-it": "^14.1.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.1",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.0"
  }
}
