+      await wait(900);
+      const vBack = await evaluate(async () => {
+        const ctl = window.__activeBrowserCtl;
+        const t = ctl?.tabs?.[0];
+        return t ? await window.mazz.invoke('bv:state', { tabId: t.viewId }).catch(() => null) : null;
+      });
