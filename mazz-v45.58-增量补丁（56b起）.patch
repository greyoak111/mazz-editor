+      await human.assert(st.presets >= 3, `PRESETS 必须桥推（${st.presets} 家）`);
+      await human.assert(st.base === 'https://api.deepseek.com' && st.model === 'deepseek-v4-pro' && st.key === 'sk-test-123',
