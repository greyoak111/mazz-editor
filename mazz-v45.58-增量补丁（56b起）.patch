+    assert.ok(!sd.includes('>⚡ 快速跳转<'), '快速跳转裸 emoji 必须绝迹');
+    const rb = readSrc('renderer/shell/ribbon.js');
+    assert.ok(rb.includes('icon: b.icon'), 'B13 stash 必须带 icon（二级菜单无 SVG 样式平反）');
+  });
