new file mode 100644
index 0000000..2ff6fa1
--- /dev/null
+++ b/renderer/panels/splitpreview.html
@@ -0,0 +1,30 @@
+<!DOCTYPE html>
+<html lang="zh-CN"><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'">
+<title>分屏预览</title>
+<link rel="stylesheet" href="../styles/themes.css">
+<style>
+  html, body { background: transparent; margin: 0; overflow: hidden; }
+  #pv { position: fixed; pointer-events: none; transition: all .08s ease; }
+</style></head><body>
+<div id="pv"></div>
+<script>
+const applyTheme = (id) => { if (id) document.documentElement.dataset.theme = id; };
+window.mazz.invoke('settings:get', { key: 'theme' }).then(t => applyTheme(typeof t === 'string' ? t : t?.id)).catch(() => {});
+window.mazz.on('theme:changed', ({ id }) => applyTheme(id));
+// 样式全由主窗算好推来（zoneGradient/锚线边框逻辑零迁移——本页纯画板）
+window.mazz.on('panel:push', (p) => {
+  const pv = document.getElementById('pv');
+  if (p?.type !== 'splitpreview') return;
+  if (p.hide) { pv.style.width = '0px'; pv.style.height = '0px'; pv.style.border = 'none'; return; }
+  const r = p.rect || {};
+  pv.style.left = (r.left || 0) + 'px';
+  pv.style.top = (r.top || 0) + 'px';
+  pv.style.width = (r.width || 0) + 'px';
+  pv.style.height = (r.height || 0) + 'px';
+  pv.style.background = p.bg || 'transparent';
+  pv.style.border = 'none';
+  if (p.borderSide && p.borderColor) pv.style[p.borderSide] = '1.5px solid ' + p.borderColor;
+});
+</script>
+</body></html>
