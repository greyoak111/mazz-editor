+    const css = readSrc('renderer/panels/panel-shared.css');
+    assert.ok(css.includes('.rb-input, .rb-select'), 'rb-input/select 族必须有');
+    assert.ok(css.includes('border-radius: 6px; padding: 4px 8px; font-size: 12px;'), 'rb 原版三值必须有');
