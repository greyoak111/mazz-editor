+<!DOCTYPE html>
+<html lang="zh-CN"><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'">
+<title>收藏当前页</title>
+<link rel="stylesheet" href="../styles/themes.css">
+<link rel="stylesheet" href="panel-shared.css">
+<style>
+  html, body { background: transparent; }
+  * { box-sizing: border-box; }
+  body { margin:0; font:13px/1.5 var(--font-ui); }
+  .pwin { display:flex; flex-direction:column; height:100vh; background:var(--bg); color:var(--fg); border-radius:12px; overflow:hidden; border:1px solid var(--border); box-shadow:0 10px 36px rgba(0,0,0,.4); }
+  .p-drag { height:12px; flex:none; -webkit-app-region:drag; }
+  .p-winbtns { position:absolute; top:2px; right:8px; display:flex; gap:2px; z-index:9; }
+  .p-winbtns button { display:inline-flex; align-items:center; justify-content:center; -webkit-app-region:no-drag; width:30px; height:22px; border:0; border-radius:6px; background:transparent; color:var(--fg-dim); cursor:pointer; font-size:12px; }
+  .p-winbtns button:hover { background:var(--bg-hover); color:var(--fg); }
+  .p-winbtns button.x:hover { background:#e81123; color:#fff; }
+  .head { display:flex; align-items:center; gap:8px; padding:10px 16px; border-bottom:1px solid var(--border); background:var(--bg-elev); flex:none; font-size:14.5px; font-weight:600; }
+  main { flex:1; min-height:0; padding:14px 18px; overflow-y:auto; display:flex; flex-direction:column; gap:11px; }
+  .row { display:flex; align-items:center; gap:10px; }
+  .row label { width:64px; flex:none; font-size:12.5px; color:var(--fg); font-weight:600; }
+  .inp, .sel { flex:1; border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:6px; padding:4px 8px; font-size:12px; font-family:var(--font-ui); }
+  .inp:focus, .sel:focus { border-color:var(--accent); outline:none; }
+  .url { flex:1; font-size:11.5px; color:var(--fg-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+  .foot { display:flex; justify-content:flex-end; gap:8px; margin-top:auto; padding-top:6px; }
+  .btn { border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:6px; padding:6px 8px; font-size:12px; cursor:pointer; font-family:var(--font-ui); }
+  .btn:hover { border-color:var(--accent); color:var(--accent); }
+  .btn.pri { background:var(--accent); color:var(--accent-fg); border-color:var(--accent); }
+</style></head><body>
+<div class="pwin">
+  <div class="p-drag"></div>
+  <div class="p-winbtns"><button id="p-min" title="最小化"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg></button><button id="p-max" title="最大化/还原"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1.5"/></svg></button><button class="x" id="p-close" title="关闭"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
+  <div class="head">☆ 收藏当前页</div>
+  <main class="ps-scroll-y">
+    <div class="row"><label>名称</label><input id="name" class="inp"></div>
+    <div class="row"><label>网址</label><span id="url" class="url ps-ellipsis"></span></div>
+    <div class="row"><label>收藏夹</label><select id="folder" class="sel"></select></div>
+    <div class="row" id="newfold-row" style="display:none"><label></label><input id="newfold" class="inp" placeholder="新收藏夹名"></div>
+    <div class="foot">
+      <button class="btn" id="cancel">取消</button>
+      <button class="btn pri" id="go">收藏</button>
+    </div>
+  </main>
+</div>
+<script>
+const $ = (s) => document.querySelector(s);
+const pwb = (a) => window.mazz.invoke('window:' + a).catch(() => {});
+$('#p-min').addEventListener('click', () => pwb('minimize'));
+$('#p-max').addEventListener('click', () => pwb('toggleMaximize'));
+$('#p-close').addEventListener('click', () => pwb('close'));
+const applyTheme = (id) => { if (id) document.documentElement.dataset.theme = id; };
+window.mazz.invoke('settings:get', { key: 'theme' }).then(t => applyTheme(typeof t === 'string' ? t : t?.id)).catch(() => {});
+window.mazz.on('theme:changed', ({ id }) => applyTheme(id));
+const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
+
+let pageInfo = null;
+window.mazz.invoke('panel:action', { type: 'bookmarkQuery' }).catch(() => {});
+window.mazz.on('panel:push', (p) => {
+  if (p?.type !== 'bookmark') return;
+  pageInfo = p;
+  $('#name').value = p.title || '';
+  $('#url').textContent = p.url || '';
+  $('#folder').innerHTML = (p.folders || []).map(f =>
+    `<option value="${esc(f.id)}" ${f.id === 'default' ? 'selected' : ''}>${esc(f.name)}</option>`).join('')
+    + '<option value="__new">＋ 新建收藏夹…</option>';
+  $('#name').focus(); $('#name').select();
+});
+$('#folder').addEventListener('change', () => {
+  $('#newfold-row').style.display = $('#folder').value === '__new' ? 'flex' : 'none';
+});
+function done(save) {
+  if (save) {
+    let folderId = $('#folder').value, newName = '';
+    if (folderId === '__new') {
+      newName = $('#newfold').value.trim();
+      if (!newName) { $('#newfold').focus(); return; }
+    }
+    window.mazz.invoke('panel:action', { type: 'bookmarkSave', name: $('#name').value.trim(), folderId, newFolderName: newName }).catch(() => {});
+  }
+  pwb('close');
+}
+$('#go').addEventListener('click', () => done(true));
+$('#cancel').addEventListener('click', () => done(false));
+document.addEventListener('keydown', (e) => {
+  if (e.key === 'Escape') done(false);
+  else if (e.key === 'Enter' && document.activeElement?.id !== 'newfold') done(true);
+  else if (e.key === 'Enter' && document.activeElement?.id === 'newfold') done(true);
+});
+</script>
+</body></html>
diff --git a/renderer/panels/ctxmenu.html b/renderer/panels/ctxmenu.html
new file mode 100644
index 0000000..d1591fe
--- /dev/null
+++ b/renderer/panels/ctxmenu.html
@@ -0,0 +1,108 @@
+<!DOCTYPE html>
+<html lang="zh-CN"><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'">
+<title>菜单</title>
+<link rel="stylesheet" href="../styles/themes.css">
+<link rel="stylesheet" href="panel-shared.css">
+<style>
+  html, body { background: transparent; }
+  * { box-sizing: border-box; }
+  body { margin:0; font:12.5px/1.45 var(--font-ui); }
+  .pwin { display:flex; flex-direction:column; max-height:100vh; background:var(--bg-elev); color:var(--fg); border-radius:10px; overflow:hidden; border:1px solid var(--border); box-shadow:0 8px 30px rgba(0,0,0,.32); }
+  .p-drag { height:6px; flex:none; -webkit-app-region:drag; }
+  main { flex:1; min-height:0; overflow-y:auto; padding:5px; }
+  .mi { display:flex; align-items:center; gap:8px; padding:5px 10px; border-radius:7px; cursor:pointer; }
+  .mi:hover, .mi.on { background:var(--accent-soft); }
+  .mi.dis { opacity:.42; cursor:default; }
+  .mi.dis:hover { background:none; }
+  .mi .ico { width:18px; text-align:center; flex:none; display:inline-flex; justify-content:center; }
+  .mi .t { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+  .mi kbd { font-size:11px; color:var(--fg-dim); font-family:var(--font-mono); background:var(--bg-active); border-radius:4px; padding:0 6px; }
+  .mi .sub { color:var(--fg-dim); font-size:11px; }
+  .sep { height:1px; background:var(--border); margin:5px 8px; }
+  /* 子菜单飞行列 */
+  .submenu { position:fixed; z-index:9; background:var(--bg-elev); border:1px solid var(--border); border-radius:10px; box-shadow:0 8px 30px rgba(0,0,0,.32); padding:5px; min-width:190px; display:none; }
+  .submenu.open { display:block; }
+</style></head><body>
+<div class="pwin">
+  <div class="p-drag"></div>
+  <main id="m" class="ps-scroll-y"></main>
+</div>
+<div class="submenu ps-scroll-y" id="sub"></div>
+<script>
+const $ = (s) => document.querySelector(s);
+const pwb = (a) => window.mazz.invoke('window:' + a).catch(() => {});
+const applyTheme = (id) => { if (id) document.documentElement.dataset.theme = id; };
+window.mazz.invoke('settings:get', { key: 'theme' }).then(t => applyTheme(typeof t === 'string' ? t : t?.id)).catch(() => {});
+window.mazz.on('theme:changed', ({ id }) => applyTheme(id));
+const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
+
+let items = [], sel = -1, subFor = null;
+function iconOf(it) {
+  if (!it.icon) return '<span class="ico"></span>';
+  // iconHtml 映射走主窗（svg 串经 push 带过来——菜单项 svg 字段直嵌）
+  return `<span class="ico">${it.svg || esc(it.icon)}</span>`;
+}
+function render() {
+  const m = $('#m');
+  m.innerHTML = items.map((it, i) => {
+    if (it.type === 'separator') return '<div class="sep"></div>';
+    return `<div class="mi${it.enabled === false ? ' dis' : ''}${i === sel ? ' on' : ''}" data-i="${i}">
+      ${iconOf(it)}<span class="t">${esc(it.label)}</span>
+      ${it.accelerator ? `<kbd>${esc(it.accelerator)}</kbd>` : ''}
+      ${it.submenu ? '<span class="sub">▸</span>' : ''}
+    </div>`;
+  }).join('');
+  m.querySelectorAll('.mi').forEach(el => {
+    el.addEventListener('click', () => pick(items[+el.dataset.i]));
+    el.addEventListener('mouseenter', () => {
+      const it = items[+el.dataset.i];
+      sel = +el.dataset.i;
+      m.querySelectorAll('.mi').forEach(x => x.classList.toggle('on', x === el));
+      if (it?.submenu) openSub(el, it);
+      else closeSub();
+    });
+  });
+}
+function openSub(anchor, it) {
+  subFor = it;
+  const r = anchor.getBoundingClientRect();
+  const sub = $('#sub');
+  sub.innerHTML = (it.submenu || []).map((s2, j) => s2.type === 'separator' ? '<div class="sep"></div>'
+    : `<div class="mi${s2.enabled === false ? ' dis' : ''}" data-j="${j}"><span class="ico"></span><span class="t">${esc(s2.label)}</span>${s2.accelerator ? `<kbd>${esc(s2.accelerator)}</kbd>` : ''}</div>`).join('');
+  sub.classList.add('open');
+  sub.style.left = Math.min(r.right - 2, innerWidth - 200) + 'px';
+  sub.style.top = Math.min(r.top, innerHeight - sub.offsetHeight - 8) + 'px';
+  sub.querySelectorAll('.mi').forEach(el => el.addEventListener('click', () => pick((it.submenu || [])[+el.dataset.j])));
+}
+function closeSub() { subFor = null; $('#sub').classList.remove('open'); }
+function pick(it) {
+  if (!it || it.enabled === false || it.submenu) return;
+  window.mazz.invoke('panel:action', { type: 'ctxmenuPick', id: it.id }).catch(() => {});
+  pwb('close');
+}
+// 键控：↑↓ 循环 / Enter 执行 / → 开子菜单 / ← 收 / Esc 关窗
+document.addEventListener('keydown', (e) => {
+  const acts = items.map((it, i) => ({ it, i })).filter(x => x.it.type !== 'separator' && x.it.enabled !== false);
+  if (!acts.length) return;
+  const cur = acts.findIndex(x => x.i === sel);
+  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+    e.preventDefault();
+    const n = acts[(cur + (e.key === 'ArrowDown' ? 1 : -1) + acts.length) % acts.length];
+    sel = n.i; render();
+    document.querySelector(`.mi[data-i="${sel}"]`)?.scrollIntoView({ block: 'nearest' });
+  } else if (e.key === 'ArrowRight') {
+    const it = items[sel];
+    if (it?.submenu) { const el = document.querySelector(`.mi[data-i="${sel}"]`); if (el) openSub(el, it); }
+  } else if (e.key === 'ArrowLeft') { closeSub(); }
+  else if (e.key === 'Enter') { e.preventDefault(); pick(items[sel]); }
+  else if (e.key === 'Escape') { if (subFor) closeSub(); else pwb('close'); }
+});
+window.mazz.invoke('panel:action', { type: 'ctxmenuQuery' }).catch(() => {});
+window.mazz.on('panel:push', (p) => {
+  if (p?.type !== 'ctxmenu') return;
+  items = p.items || [];
+  render();
+});
+</script>
+</body></html>
