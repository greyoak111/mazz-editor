+// 回原标签测响应
+const r2 = await testInput('【关新标签后】');
+const frozen = r2.err || (r2.clicks === 0 && r2.scrollY === 0);
+console.log(frozen ? '❄️ 复现：原标签僵死' : '✅ 原标签仍活');
