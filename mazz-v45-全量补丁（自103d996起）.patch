+/* v45 全屏逃生钮 */
+.fs-exit { position: fixed; right: 18px; bottom: 18px; z-index: 9999; border: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(8px); color: var(--fg); border-radius: 999px; padding: 8px 18px; font-size: 12.5px; cursor: pointer; box-shadow: 0 4px 18px rgba(0,0,0,.25); opacity: .88; }
+.fs-exit:hover { opacity: 1; background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
+
+.mz-side-x { margin-left: auto; border: 0; background: none; color: var(--fg-dim); cursor: pointer; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
+.mz-side-x:hover { color: var(--fg); background: var(--bg-hover); }
