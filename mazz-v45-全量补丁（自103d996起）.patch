+/* renderer/styles/mobile.css —— 移动端/折叠屏自适应层
+   由 lib/mobile-env.js 在 <html> 上挂类驱动：m-web / m-touch / m-phone / m-tablet / m-wide / m-dualscreen / m-sidebar-open
+   断点对齐 Material 3 窗口尺寸类：手机 <600dp · 平板 600–839dp · 桌面 ≥840dp
+   全部规则限定在移动类名下，桌面端零影响 */
+
+/* ================= 基础：安全区 + 触屏 ================= */
+html { -webkit-text-size-adjust: 100%; }
+
+/* WebView/浏览器里窗口控制按钮无意义（仅 Electron Windows 用得到） */
+html.m-web .titlebar .tb-win-controls { display: none; }
+
+/* 状态栏/标题栏避开刘海与手势条 */
+.titlebar { padding-top: env(safe-area-inset-top, 0px); }
+.statusbar { padding-bottom: env(safe-area-inset-bottom, 0px); }
+
+/* 触屏：可点目标 ≥40dp */
+@media (pointer: coarse) {
+  .rb-btn { min-width: 42px; min-height: 42px; }
+  .ribbon-tab { min-height: 34px; padding-left: 12px; padding-right: 12px; }
+  .tabbar .tab, .tabbar [class*="tab"] { min-height: 38px; }
+  .sidebar-rail { width: 40px; }
+  .statusbar { min-height: 28px; }
+}
+
+/* 触屏：1px 分隔条加大热区（视觉不变） */
+html.m-touch .pane-divider,
+html.m-touch .ribbon-grip,
+html.m-touch .sidebar-grip { position: relative; }
+html.m-touch .pane-divider::after,
+html.m-touch .ribbon-grip::after,
+html.m-touch .sidebar-grip::after {
+  content: ''; position: absolute; inset: -7px; z-index: 31;
+}
+
