+.sb-list { overflow-y: auto; flex: 1; }
+.sb-empty { padding: 18px 12px; font-size: 12px; color: var(--fg-dim); text-align: center; }
+.sb-item { display: flex; align-items: center; gap: 6px; padding: 5px 10px; font-size: 12.5px; cursor: pointer; border-radius: 5px; }
+.sb-item:hover { background: var(--bg-hover); }
+.sb-item .mz-ico { width: 14px; height: 14px; flex: none; color: var(--fg-dim); }
