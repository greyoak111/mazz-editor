+});
+const pane = await win.evaluate(() => { const r = document.querySelector('.pane').getBoundingClientRect(); return { x: r.x, y: r.y, w: r.width, h: r.height }; });
+
+await win.mouse.move(tabBox.x, tabBox.y);
