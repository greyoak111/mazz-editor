+// tests/fuzz/run.mjs —— 模糊测试靶场：随机/畸形/截断输入轰炸手写解析器
+// 目标：崩溃（未捕获异常）、挂起（超时）、破坏性输出（违反不变量）
+import { randomBytes } from 'node:crypto';
+import '../contract/_setup.mjs';
