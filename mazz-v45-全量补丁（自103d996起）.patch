+// renderer/help/content-senior.js —— 喂奶级帮助文档（零基础老人版）
+// 写法约定：短句、不堆术语、每一步说清点哪里、出错了怎么办
+
+export const SENIOR_SECTIONS = [
+{
+  id: 's-hello', icon: '👋', title: '先认识这个软件（第一课）',
+  body: `# 先认识这个软件
+
+这个软件叫 **Mazz Editor**，你可以把它当成一个**大抽屉柜**：
+写东西的、做表的、看视频的、看书的、画画的，都装在这一个柜子里，不用来回换软件。
+
+## 打开之后你看到三样东西
+
+1. **最上面一条彩色横条**——这是按钮区，所有功能都在这。想找什么功能，先往这看。
+2. **左边一列**——这是你的文件柜，你存的所有东西都列在这。
+3. **中间大块空白**——这是你干活的地方，写什么、看什么都在这里。
+
+## 你最常用的就三个动作
+
+- **想写点新东西**：点左上角的「＋ 文档」，直接就能打字。
+- **想找以前写的东西**：看左边文件柜，找到名字，**点两下**就打开了。
+- **写完怕丢**：点最上面的「保存」，或者按住键盘左下角的 Ctrl 键不动、再按一下字母 S。存好了它会记住。
+
+## 按错了怎么办
+
+别慌。这个软件**怎么点都点不坏**。真的弄乱了，把软件整个关掉（点右上角 ✕），再打开，东西还在。
+`,
+},
+{
+  id: 's-files', icon: '🗂', title: '文件柜：存东西找东西',
+  body: `# 文件柜（左边那一列）
+
+你的所有东西都存在一个固定的地方，叫**工作区**（就在电脑「文档」文件夹里）。左边这一列就是你的工作区。
+
+## 新建一个文件
+
+1. 看左列最上面，有个 **「＋」** 小按钮，点一下。
+2. 它会问你建哪种，一般选第一个「文档」就行。
+3. 起个名字，回车。新文件就在列表里了。
+
+## 新建一个文件夹（把东西分类放）
+
+点左列最上面的 **小文件夹图标**，会自动起名叫「新建文件夹」，你可以马上打字改成你想要的名字，比如「菜谱」「孙子的照片」。
+
+## 改名、删除
+
+- **改名**：在那个文件上**点右键**（鼠标右边那个键），选「重命名」。
+- **删除**：点右键选「删除」，或者选中后按键盘上的 Delete 键。删掉的东西先进回收站，不会立刻没，放心。
+
+## 拖来拖去
+
+想把文件挪进文件夹：**按住文件不松手**，拖到文件夹名字上，松手。
+`,
+},
+{
+  id: 's-write', icon: '📝', title: '写东西（文档）',
+  body: `# 写东西（最常用）
+
+点「＋ 文档」就能开始写。这跟用本子写字差不多，只不过在本子上是手写，这里是打字。
+
+## 让字变大一点、好看一点
+
+- **字太小看不清**：按住 Ctrl 键不动，**滚动鼠标中间的小轮子**，字就变大了。往后滚变小。
+- **想加粗**：先用鼠标把那几个字抹黑（选中），再点上面的 **B**。
+- **想换个标题**：在一行开头打个「井号键 #」再打个空格，这行就变成大标题了。
+
+## 往里面放照片
+
+**最简单的办法**：把照片文件**直接拖进来**（从桌面上按住拖到这个窗口里），照片就进去了。
+
+## 写完一定记得保存
+
+按 **Ctrl + S**（按住 Ctrl 再按 S）。标题上不出现小圆点，就说明存好了。
+`,
+},
+{
+  id: 's-sheet', icon: '📊', title: '做表格（记账、记名单）',
+  body: `# 做表格
+
+点最上面的「表格」，就出现一张像 Excel 那样的格子纸。
+
+## 基本用法
+
+- **往格子里写字**：**点两下**那个格子，就能打字了。打完按回车（Enter）。
+- **格子太窄**：把鼠标放到最上面字母之间的竖线上，**按住往左右拖**。
+- **想让某一行有颜色**：选中那几格，点上面的填充色（小油漆桶样）。
+
+## 算账（求和）
+
+在最下面一格写：\`=SUM(A1:A10)\`，回车。它就把 A1 到 A10 这些格子里的数全加起来了。
+（A 是第一列，1 是第一行，A1 就是左上角那格。）
+
+## 表格存成 Excel 能打开的
+
+写好后点「另存为」，存成 **.xlsx** 结尾的文件，拿到别的电脑上用 Excel、WPS 都能打开。
+`,
