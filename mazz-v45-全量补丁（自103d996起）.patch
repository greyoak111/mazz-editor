+.draw-tool-row1 { display: flex; gap: 3px; flex-wrap: wrap; align-items: center; }
+.draw-tool-row1 button { border: 0; background: none; font-size: 15px; padding: 4px 7px; border-radius: 6px; cursor: pointer; color: inherit; }
+.draw-tool-row1 button.on { background: var(--accent-soft, #e0e7ff); outline: 1px solid var(--accent, #4f46e5); }
+.draw-tool-row2 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 11.5px; color: var(--fg-dim); border-top: 1px dashed var(--bd, #e0ded8); padding-top: 4px; }
+.draw-tool-row2 label { display: flex; align-items: center; gap: 4px; }
+.draw-tool-row2 input[type=range] { width: 76px; }
+.draw-tool-row2 button { border: 1px solid var(--bd, #e0ded8); background: none; border-radius: 5px; padding: 2px 8px; font-size: 11.5px; cursor: pointer; color: inherit; }
+.draw-tool-row2 button.on, .draw-rec.on { background: #dc2626; color: #fff; border-color: #dc2626; }
+
+/* —— 画板折叠面板 —— */
+.draw-collapse-ts { position: absolute; top: 8px; right: 8px; z-index: 12; border: 1px solid var(--bd,#e0ded8); background: var(--bg-elev,#fff); border-radius: 6px; width: 22px; height: 22px; cursor: pointer; color: var(--fg-dim); padding: 0; }
+.draw-tool-strip.collapsed { display: none; }
+.draw-collapse-side { border: 0; background: none; color: var(--fg-dim); cursor: pointer; padding: 0 4px; font-size: 12px; }
+.draw-side { transition: width .18s ease; overflow: hidden; }
+.draw-side.collapsed { width: 22px !important; }
+.draw-side.collapsed > *:not(.draw-sect) { display: none; }
+.draw-side.collapsed .draw-sect { writing-mode: vertical-rl; font-size: 11px; padding: 6px 2px; }
+.lasso-bar button:hover { background: var(--bg-hover, #ecebe6); }
+
+/* —— 图片/PDF 查看器 —— */
+.viewer-root { display: flex; flex-direction: column; height: 100%; background: var(--bg); }
+.viewer-bar { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-bottom: 1px solid var(--border); background: var(--bg-elev); font-size: 12.5px; }
+.viewer-bar button { border: 1px solid var(--border); background: var(--bg); color: var(--fg); border-radius: 6px; padding: 4px 10px; cursor: pointer; }
+.viewer-bar button:hover { background: var(--bg-hover); }
+.viewer-pct { min-width: 44px; text-align: center; color: var(--fg-dim); }
+.viewer-name { margin-left: auto; color: var(--fg-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.viewer-body { flex: 1; overflow: auto; display: grid; place-items: center; background: color-mix(in srgb, var(--bg) 92%, #000 8%); }
+.viewer-body img { display: block; }
+.viewer-pdf { width: 100%; height: 100%; border: 0; }
+.viewer-err { color: var(--fg-dim); padding: 30px; }
+
+/* —— 页签拖拽分屏盾牌：webview/iframe 会吞 HTML5 拖拽事件，拖签期间盖住保证事件可达 —— */
+body.tab-dragging .editor-area::after { content: ''; position: absolute; inset: 0; z-index: 40; }
+
+/* —— 演示单页缩放控件 —— */
+.sl-zoomctl { position: absolute; right: 14px; bottom: 12px; z-index: 30; display: flex; align-items: center; gap: 4px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 8px; padding: 3px 8px; font-size: 12px; box-shadow: var(--shadow); }
+.sl-zoomctl button { border: 0; background: none; color: var(--fg); cursor: pointer; padding: 2px 7px; border-radius: 5px; font-size: 13px; }
+.sl-zoomctl button:hover { background: var(--bg-hover); }
+.sl-zoomctl span { min-width: 38px; text-align: center; color: var(--fg-dim); }
+
+/* —— 应用内浮动窗口（打印/分页预览） —— */
+.appwin-mask { position: fixed; inset: 0; z-index: 90; background: rgba(30, 30, 26, .32); }
+.appwin { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 18px 60px rgba(0, 0, 0, .28); overflow: hidden; }
+.appwin.max { left: 0 !important; top: 0 !important; width: 100vw !important; height: 100vh !important; transform: none; border-radius: 0; }
+.appwin:not(.max) { left: 50%; top: 50%; }
+.appwin-bar { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 12px; background: var(--bg-elev); border-bottom: 1px solid var(--border); cursor: move; user-select: none; }
+.appwin-title { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.appwin-acts { display: flex; gap: 6px; }
+.appwin-btn { border: 1px solid var(--border); background: var(--bg); color: var(--fg); border-radius: 6px; width: 28px; height: 24px; cursor: pointer; font-size: 12px; line-height: 1; }
+.appwin-btn:hover { background: var(--bg-hover); }
+.appwin-body { flex: 1; overflow: auto; display: flex; flex-direction: column; }
+.appwin-resize { position: absolute; right: 0; bottom: 0; width: 18px; height: 18px; cursor: nwse-resize; z-index: 5; background: linear-gradient(135deg, transparent 55%, var(--fg-dim, #a3a19a) 55%, var(--fg-dim, #a3a19a) 65%, transparent 65%, transparent 72%, var(--fg-dim, #a3a19a) 72%, var(--fg-dim, #a3a19a) 82%, transparent 82%); }
+.appwin.max .appwin-resize { display: none; }
+
+/* —— 查看器音视频与降级卡 —— */
+.viewer-video { max-width: 100%; max-height: 100%; outline: none; background: #000; }
+.viewer-audio-card { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 40px 30px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 14px; min-width: 340px; }
+.va-ico { font-size: 44px; }
+.va-name { font-size: 13.5px; color: var(--fg); word-break: break-all; text-align: center; }
+.viewer-fallback { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 50px 30px; }
+.vf-ico { font-size: 48px; }
+.vf-name { font-size: 14px; font-weight: 600; word-break: break-all; text-align: center; }
+.vf-reason { font-size: 12.5px; color: var(--fg-dim); }
+
+/* —— 欢迎页双栏：左 5×3 卡片 / 右 2×2 打开方式 —— */
+.w-cols { display: flex; gap: 26px; align-items: flex-start; justify-content: center; flex-wrap: wrap; }
+.w-openwith { flex: none; width: 300px; background: color-mix(in srgb, var(--accent) 6%, var(--bg-elev)); border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border)); border-radius: 14px; padding: 16px 16px 14px; }
+.w-ow-title { font-size: 12px; font-weight: 700; color: var(--accent); letter-spacing: 2px; margin-bottom: 10px; }
+.w-drop { border: 2px dashed color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius: 12px; padding: 22px 12px; text-align: center; cursor: pointer; transition: all .15s; background: color-mix(in srgb, var(--accent) 4%, transparent); }
+.w-drop:hover, .w-drop.on { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); transform: scale(1.015); }
+.w-drop-ico { font-size: 30px; color: var(--accent); line-height: 1; }
+.w-drop-t { font-size: 14px; font-weight: 600; color: var(--fg); margin-top: 8px; }
+.w-drop-d { font-size: 11.5px; color: var(--fg-dim); margin-top: 3px; }
+.w-ow-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
+.w-ow-card { border: 1px solid var(--border); background: var(--bg); color: var(--fg); border-radius: 10px; padding: 10px 10px 8px; cursor: pointer; text-align: left; transition: all .12s; }
+.w-ow-card:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, var(--bg)); }
+.w-ow-card .t { font-size: 12.5px; font-weight: 600; }
+.w-ow-card .d { font-size: 11px; color: var(--fg-dim); margin-top: 2px; }
+html.m-phone .w-openwith { width: 100%; max-width: 420px; }
+
+/* —— 侧栏页签 —— */
+.sb-tabs { display: flex; gap: 2px; padding: 6px 8px 0; border-bottom: 1px solid var(--border); }
+.sb-tab { border: 0; background: none; color: var(--fg-dim); padding: 6px 12px; cursor: pointer; font-size: 12.5px; border-bottom: 2px solid transparent; font-family: var(--font-ui); }
+.sb-tab.on { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
+.sb-page { flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
+
+/* —— 焚诀工坊面板 —— */
+.factory-root { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
+.factory-body { flex: 1; overflow-y: auto; padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
+.fc-row select { width: 100%; }
+.fc-genre { background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; font-size: 12.5px; }
+.fc-provider-hint { font-size: 11.5px; }
+.fc-ok { color: #16a34a; }
+.fc-warn { color: #d97706; }
+.fc-gdesc { font-size: 11px; color: var(--fg-dim); }
+.fc-field { display: flex; flex-direction: column; gap: 3px; margin-bottom: 8px; }
+.fc-field label { font-size: 11.5px; color: var(--fg-dim); }
+.fc-field input, .fc-field textarea, .fc-field select { background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; font-size: 12.5px; font-family: var(--font-ui); }
+.fc-req { color: #dc2626; }
+.fc-label { font-size: 11.5px; color: var(--fg-dim); display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
+.fc-dump-text { width: 100%; background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 8px; padding: 8px; font-size: 12.5px; resize: vertical; font-family: var(--font-ui); }
+.fc-actions { display: flex; gap: 8px; }
+.fc-btn { border: 1px solid var(--border); background: var(--bg-elev); color: var(--fg); border-radius: 8px; padding: 8px 12px; cursor: pointer; font-size: 12.5px; flex: 1; }
+.fc-btn:hover { border-color: var(--accent); }
+.fc-btn:disabled { opacity: .5; cursor: default; }
+.fc-accent { background: var(--accent); color: var(--accent-fg, #fff); border-color: var(--accent); }
+.fc-mini { border: 1px solid var(--border); background: none; color: var(--fg-dim); border-radius: 5px; padding: 2px 8px; cursor: pointer; font-size: 11px; }
+.fc-mini:hover { color: var(--accent); border-color: var(--accent); }
+.fc-check { font-size: 11.5px; color: var(--fg-dim); display: flex; gap: 5px; align-items: center; }
+.fc-tasklist, .fc-hislist { display: flex; flex-direction: column; gap: 4px; }
+.fc-task, .fc-his { display: flex; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 7px; padding: 5px 8px; font-size: 12px; }
+.fc-task-label, .fc-his-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.fc-task-status { font-size: 11px; color: var(--fg-dim); flex: none; }
+.fc-his-genre { font-size: 11px; color: var(--fg-dim); flex: none; }
+.fc-empty { font-size: 11.5px; color: var(--fg-dim); padding: 6px 2px; }
+.fc-status { font-size: 12px; color: var(--fg-dim); min-height: 18px; }
+.fc-batch-acts { display: flex; gap: 4px; }
+
+/* —— 欢迎页焚诀大卡 —— */
+.w-factory-card { margin-top: 12px; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); border-radius: 12px; padding: 14px 16px; cursor: pointer; background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent), color-mix(in srgb, var(--accent) 4%, transparent)); transition: all .15s; }
+.w-factory-card:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 6px 20px color-mix(in srgb, var(--accent) 18%, transparent); }
+.wf-head { display: flex; align-items: center; gap: 8px; }
+.wf-ico { font-size: 20px; }
+.wf-title { font-size: 15px; font-weight: 700; color: var(--fg); }
+.wf-tag { margin-left: auto; font-size: 10.5px; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 99px; padding: 2px 8px; }
+.wf-desc { font-size: 11.5px; color: var(--fg-dim); margin-top: 6px; line-height: 1.6; }
+
+/* —— 右侧工具坞 —— */
+.side-dock { position: fixed; top: 86px; right: 0; bottom: 30px; z-index: 70; display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--border); border-right: 0; border-radius: 12px 0 0 12px; box-shadow: -8px 0 30px rgba(0,0,0,.16); }
+.side-dock.floating { border-radius: 12px; border: 1px solid var(--border); top: 86px; }
+.sd-bar { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 7px 10px; background: var(--bg-elev); border-bottom: 1px solid var(--border); border-radius: 12px 0 0 0; cursor: move; user-select: none; }
+.side-dock.floating .sd-bar { border-radius: 12px 12px 0 0; }
+.sd-tabs { display: flex; gap: 4px; }
+.sd-tab { border: 0; background: none; color: var(--fg-dim); padding: 4px 10px; cursor: pointer; font-size: 12.5px; border-radius: 6px; font-family: var(--font-ui); }
+.sd-tab.on { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
+.sd-acts { display: flex; align-items: center; gap: 4px; }
+.sd-btn { border: 1px solid var(--border); background: var(--bg); color: var(--fg-dim); border-radius: 5px; width: 22px; height: 20px; cursor: pointer; font-size: 11px; line-height: 1; }
+.sd-btn:hover { color: var(--accent); border-color: var(--accent); }
+.sd-zoom { font-size: 11px; color: var(--fg-dim); min-width: 32px; text-align: center; }
+.sd-body { flex: 1; overflow: auto; min-height: 0; }
+.sd-grip { position: absolute; left: -4px; top: 0; bottom: 0; width: 8px; cursor: ew-resize; z-index: 5; }
+.sd-grip:hover { background: color-mix(in srgb, var(--accent) 25%, transparent); }
+.sd-openwith { padding: 12px; }
+.factory-root { height: 100%; }
+.factory-root .sidebar-head { border-bottom: 1px solid var(--border); }
+
+/* —— 工具坞工具页 —— */
+.sd-body { display: flex; flex-direction: column; }
+.sd-body .factory-root { flex: 1; min-height: 0; }
+.sd-openwith { overflow-y: auto; }
+.sd-tools { overflow-y: auto; padding: 12px; }
+.sd-tools-group { margin-bottom: 14px; }
+.sd-tools-label { font-size: 11px; font-weight: 700; color: var(--accent); letter-spacing: 1px; margin-bottom: 6px; }
+.sd-tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
+.sd-tool-card { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); background: var(--bg); border-radius: 9px; padding: 8px 9px; cursor: pointer; text-align: left; transition: all .12s; }
+.sd-tool-card:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, var(--bg)); }
+.sd-tool-ico { font-size: 17px; flex: none; }
+.sd-tool-text { display: flex; flex-direction: column; min-width: 0; }
+.sd-tool-text b { font-size: 12px; color: var(--fg); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.sd-tool-text i { font-size: 10.5px; color: var(--fg-dim); font-style: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+
+/* —— 工具坞智能创作容器 —— */
+.sd-factory-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column; }
+.sd-factory-wrap .factory-root { flex: 1; min-height: 0; }
+
+/* —— 全局批注层（外套） —— */
+.annotate-layer { position: fixed; inset: 0; z-index: 80; pointer-events: none; }
+.annotate-canvas { position: absolute; inset: 0; cursor: crosshair; touch-action: none; pointer-events: auto; }
+.annotate-bar { position: fixed; left: 50%; transform: translateX(-50%); z-index: 81; pointer-events: auto; display: flex; align-items: center; gap: 6px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 99px; padding: 6px 10px 6px 6px; box-shadow: var(--shadow); }
+.an-body { display: flex; align-items: center; gap: 8px; }
+.annotate-bar.collapsed .an-body { display: none; }
+.annotate-bar.collapsed { padding: 6px; }
+.an-fold { border: 0; background: none; color: var(--fg-dim); cursor: pointer; font-size: 12px; width: 22px; height: 22px; border-radius: 50%; }
+.an-fold:hover { color: var(--accent); background: var(--bg-hover); }
+.an-c { width: 20px; height: 20px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
+.an-c.on { border-color: var(--fg); transform: scale(1.15); }
+.an-sep { width: 1px; height: 18px; background: var(--border); }
+.an-size { width: 80px; }
+.an-btn { border: 1px solid var(--border); background: var(--bg); color: var(--fg); border-radius: 99px; padding: 5px 12px; cursor: pointer; font-size: 12px; }
+.an-btn:hover { border-color: var(--accent); color: var(--accent); }
+.an-exit { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
+
+/* —— 书库 PDF 阅读页 —— */
+.lib-pdf { width: 100%; height: 100%; border: 0; }
+
+/* —— 书库增强 —— */
+.lib-card-cat { position: absolute; left: 6px; top: 6px; background: color-mix(in srgb, var(--accent) 80%, #000 10%); color: #fff; font-size: 10px; border-radius: 4px; padding: 1px 6px; opacity: .92; }
+.lib-card { position: relative; }
+.lib-card.batching { outline: 1.5px dashed var(--border); }
+.lib-card.selected { outline: 2px solid var(--accent); }
+.lib-card-cb { position: absolute; right: 6px; top: 6px; width: 16px; height: 16px; }
+.lib-batch-bar { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-top: 1px solid var(--border); background: var(--bg-elev); font-size: 12.5px; }
+.lib-batch-bar .lib-batch-n { margin-right: auto; color: var(--fg-dim); }
+.lib-progress { flex: none; display: flex; align-items: center; gap: 10px; padding: 6px 14px; border-top: 1px solid var(--border); background: var(--bg-elev); }
+.lib-prog-track { flex: 1; height: 5px; background: var(--bg-active); border-radius: 3px; overflow: hidden; }
+.lib-prog-fill { height: 100%; width: 0%; background: var(--accent); border-radius: 3px; transition: width .2s; }
+.lib-pos { flex: none; font-size: 12px; color: var(--fg-dim); min-width: 130px; text-align: right; }
+.lib-double { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
+/* 文本双页：以窗格中轴线分割，两页占满整格（漫画模式见上专属规则） */
+.lib-double.lib-double-full { height: 100%; gap: 0; align-items: stretch; }
+.lib-double.lib-double-full > div { min-width: 0; overflow: hidden; }
+.lib-double .lib-text-page { min-width: 0; overflow-wrap: break-word; }
+.lib-page-sep { border: 0; border-top: 1px dashed var(--border); margin: 28px 0; }
+.lib-search-bar { position: absolute; right: 8px; top: 100%; z-index: 30; display: flex; gap: 6px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; box-shadow: var(--shadow); }
+.lib-reader-bar { position: relative; }
+.lib-search-results { padding: 4px; }
+
+/* —— Mazz Player（PotPlayer 风深色皮肤） —— */
+.mz-player-root { height: 100%; width: 100%; } /* 必须撑满：此前只高不宽，音频无 video 元素撑场，容器塌成 148px disc 窄条（阴间比例实锤） */
+.mz-player { height: 100%; background: var(--bg); color: var(--fg); }
+.mz-stage { position: relative; height: 100%; display: flex; flex-direction: column; overflow: hidden; }
+.mz-media { flex: 1; min-height: 0; width: 100%; background: #000; outline: none; object-fit: contain; }
+.mz-stage.fs .mz-media { background: #000; }
+.mz-audio-wrap { flex: 1; min-height: 0; position: relative; display: grid; place-items: center; background: radial-gradient(ellipse at 50% 40%, color-mix(in srgb, var(--accent) 12%, var(--bg)) 0%, var(--bg) 72%); }
+.mz-spectrum { position: absolute; inset: auto 0 0 0; bottom: 0; width: 100%; height: 42%; opacity: .85; }
+.mz-audio-disc { position: relative; z-index: 1; width: 148px; height: 148px; border-radius: 50%; display: grid; place-items: center; font-size: 54px; background: conic-gradient(var(--bg-active), var(--bg), var(--bg-active), var(--bg), var(--bg-active)); border: 2px solid var(--border); box-shadow: var(--shadow), inset 0 0 0 14px var(--bg-elev), inset 0 0 0 15px var(--border); }
+.mz-audio-disc.spin { animation: mzspin 6s linear infinite; }
+@keyframes mzspin { to { transform: rotate(360deg); } }
+.mz-topbar { position: absolute; top: 0; left: 0; right: 0; z-index: 5; display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: transparent; transition: opacity .3s; }
+.mz-topbar .mz-name, .mz-topbar .mz-meta { text-shadow: 0 1px 3px rgba(0,0,0,.55); }
+.mz-topbar > *, .mz-bar > * { filter: drop-shadow(0 1px 2px rgba(0,0,0,.45)); }
+.mz-name { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46%; color: var(--fg); }
+.mz-meta { font-size: 11px; color: var(--fg-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
+.mz-x { border: 0; background: none; color: var(--fg-dim); font-size: 15px; cursor: pointer; padding: 2px 8px; border-radius: 5px; }
+.mz-x:hover { color: var(--fg); background: var(--bg-hover); }
+.mz-controls { position: absolute; left: 0; right: 0; bottom: 0; z-index: 5; padding: 6px 14px 10px; background: transparent; transition: opacity .3s; }
+.mz-bar { background: color-mix(in srgb, var(--bg) 62%, transparent); backdrop-filter: blur(8px); border-radius: 10px; padding: 2px 6px; }
+.mz-controls.fade, .mz-topbar.fade { opacity: 0; pointer-events: none; }
