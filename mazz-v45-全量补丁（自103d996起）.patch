+    if (!blueprint || retryChapter === -1 /* -1 = 蓝图重试 */) {
+      const stylePkg = assembleStylePackage({
+        traditional: task.values['文风学习对象'] || '',
+        styleIds: task.styleIds || [], styles: this.styles,
