+}
+
+// ============ 6) markdown 往返 ============
+function fuzzMarkdown() {
+  const pieces = ['# t', '**b**', '*i*', '<u>u</u>', '- l', '1. n', '> q', '```js\ncode\n```', '|a|b|\n|-|-|\n|1|2|', '[x](y)', '[[双链]]', '<!--page:{}-->', '\u200b', '　', '\n\n\n'];
