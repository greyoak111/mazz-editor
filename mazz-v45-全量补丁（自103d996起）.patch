+<navPoint id="n2" playOrder="2"><navLabel><text>第二章 回声</text></navLabel><content src="c2.xhtml"/></navPoint>
+</navMap></ncx>`,
+    'OEBPS/c1.xhtml': xhtml('第一章 起风', c1),
