+  await win.keyboard.press('Escape'); await win.waitForTimeout(300);
+}
+
+// 开两个 tab（表格+文档），拖表格 tab 到右区分屏
+await win.evaluate(() => window.MazzCommands?.execute('file.newSheet'));
+await win.waitForTimeout(1500);
