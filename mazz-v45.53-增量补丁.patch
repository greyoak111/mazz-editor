+  .opts label { display:flex; align-items:center; gap:5px; }
+  .sel { border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:6px; padding:3px 8px; font-size:12px; font-family:var(--font-ui); }
+  .btn { border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:7px; padding:7px 20px; font-size:13px; cursor:pointer; font-family:var(--font-ui); }
+  .btn:hover { border-color:var(--accent); color:var(--accent); }
