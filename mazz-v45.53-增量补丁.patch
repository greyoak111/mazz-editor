+  .btn:hover { border-color:var(--accent); color:var(--accent); }
+  .btn:disabled { opacity:.4; cursor:default; }
+  .head .note { font-size:11px; color:var(--fg-dim); }
+  main { flex:1; min-height:0; padding:10px 16px; overflow-y:auto; }
+  .plg { display:flex; align-items:center; gap:10px; padding:9px 6px; border-bottom:1px solid var(--border); }
+  .plg .ico { font-size:20px; width:26px; text-align:center; flex:none; }
+  .plg .info { flex:1; min-width:0; }
+  .plg .name { font-weight:600; font-size:13px; }
+  .plg .name small { color:var(--fg-dim); font-weight:400; }
+  .plg .desc { font-size:11.5px; color:var(--fg-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+  .plg .desc.err { color:#c2410c; }
+  .empty { color:var(--fg-dim); text-align:center; padding:40px 0; line-height:2; }
+</style></head><body>
+<div class="pwin">
+  <div class="p-drag"></div>
+  <div class="p-winbtns"><button id="p-min" title="最小化"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg></button><button id="p-max" title="最大化/还原"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1.5"/></svg></button><button class="x" id="p-close" title="关闭"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
+  <div class="head">
+    <span class="t">插件管理</span>
+    <span class="note">.maz = zip 包（plugin.json + main.js）</span>
+    <button class="btn" id="install">＋ 安装插件</button>
+  </div>
+  <main id="m" class="ps-scroll-y"><div class="empty">加载中…</div></main>
+</div>
+<script>
+const $ = (s) => document.querySelector(s);
+const pwb = (a) => window.mazz.invoke('window:' + a).catch(() => {});
+$('#p-min').addEventListener('click', () => pwb('minimize'));
+$('#p-max').addEventListener('click', () => pwb('toggleMaximize'));
+$('#p-close').addEventListener('click', () => pwb('close'));
+const applyTheme = (id) => { if (id) document.documentElement.dataset.theme = id; };
+window.mazz.invoke('settings:get', { key: 'theme' }).then(t => applyTheme(typeof t === 'string' ? t : t?.id)).catch(() => {});
+window.mazz.on('theme:changed', ({ id }) => applyTheme(id));
+const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
+
+let rows = [];
+function ask() { window.mazz.invoke('panel:action', { type: 'pluginsQuery' }).catch(() => {}); }
+function act(actName, extra = {}) { window.mazz.invoke('panel:action', { type: 'pluginsAction', act: actName, ...extra }).catch(() => {}); }
+
+function render() {
+  const m = $('#m');
+  if (!rows.length) {
+    m.innerHTML = '<div class="empty">还没有安装插件——点「安装插件」选择 .maz 文件<br><small>交付包 samples/ 目录自带两个示例插件</small></div>';
+    return;
+  }
+  m.innerHTML = rows.map((r, i) => `
+    <div class="plg" data-i="${i}">
+      <span class="ico">${r.error ? '⚠' : '🧩'}</span>
+      <div class="info">
+        <div class="name">${esc(r.name)} <small>v${esc(r.version)}</small></div>
+        <div class="desc${r.error ? ' err' : ''}">${esc(r.error || r.desc || r.id)}</div>
+      </div>
+      ${r.error ? '' : `
+        <button class="btn" data-a="open" ${r.enabled ? '' : 'disabled'}>打开</button>
+        <button class="btn" data-a="toggle">${r.enabled ? '禁用' : '启用'}</button>`}
+      <button class="btn" data-a="del">删除</button>
+    </div>`).join('');
+  m.querySelectorAll('.plg button').forEach(b => b.addEventListener('click', () => {
+    const r = rows[+b.closest('.plg').dataset.i];
+    if (!r) return;
+    act(b.dataset.a, { id: r.id, path: r.path, enabled: r.enabled, name: r.name });
+  }));
+}
+window.mazz.on('panel:push', (p) => {
+  if (p?.type !== 'plugins') return;
+  rows = p.rows || [];
+  render();
+});
+$('#install').addEventListener('click', () => act('install'));
+document.addEventListener('keydown', (e) => { if (e.key === 'Escape') pwb('close'); });
+ask();
+</script>
+</body></html>
