+    await wait(1200);
+    const hasModal2 = await kid.evaluate(() => {
+      const masks = [...document.querySelectorAll('.mazz-palette-mask')].filter(e => e.getBoundingClientRect().width > 0);
+      return masks.length;
+    }).catch(() => null);
+    human.log('子窗 modal 复查:', hasModal2);
