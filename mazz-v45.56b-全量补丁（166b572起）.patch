+  <div class="p-winbtns"><button id="p-min" title="最小化"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg></button><button id="p-max" title="最大化/还原"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1.5"/></svg></button><button class="x" id="p-close" title="关闭"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
+  <div class="head">
+    <span class="tabs"><button class="tab on" data-t="commands">命令</button><button class="tab" data-t="files">文件</button></span>
+    <input id="q" placeholder="输入命令名或拼音/缩写检索…" autofocus>
+  </div>
+  <main id="m" class="mazz-scroll"></main>
+</div>
+<script>
+const $ = (s) => document.querySelector(s);
+const pwb=(a)=>window.mazz.invoke('window:'+a).catch(()=>{});
+$('#p-min').addEventListener('click',()=>pwb('minimize'));
+$('#p-max').addEventListener('click',()=>pwb('toggleMaximize'));
+$('#p-close').addEventListener('click',()=>pwb('close'));
+const applyTheme=(id)=>{ if(id) document.documentElement.dataset.theme=id; };
+window.mazz.invoke('settings:get',{key:'theme'}).then(t=>applyTheme(typeof t==='string'?t:t?.id)).catch(()=>{});
+window.mazz.on('theme:changed',({id})=>applyTheme(id));
+const esc=(s)=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
+let items = [], sel = 0, qT = null, tab = 'commands';
+// 初始页签桥问（file.quickOpen 收编入口暂存——主窗推 initTab）
+window.mazz.invoke('panel:action', { type: 'paletteInitQuery' }).catch(() => {});
+function setTab(t) {
+  tab = t;
+  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.t === t));
+  $('#q').placeholder = t === 'files' ? '输入文件名…（最近文件 + 工作区）' : '输入命令名或拼音/缩写检索…';
+  sel = 0; ask();
+}
+document.querySelectorAll('.tab').forEach(b => b.addEventListener('click', () => setTab(b.dataset.t)));
+function ask() {
+  clearTimeout(qT);
+  qT = setTimeout(() => window.mazz.invoke('panel:action', { type: tab === 'files' ? 'quickopenQuery' : 'paletteQuery', q: $('#q').value.trim() }).catch(() => {}), 80);
+}
+function render() {
+  const m = $('#m');
+  if (!items.length) { m.innerHTML = '<div class="empty">无匹配命令</div>'; return; }
+  m.innerHTML = items.map((it, i) => '<div class="row' + (i === sel ? ' on' : '') + '" data-i="' + i + '">'
+    + '<span class="t">' + esc(it.title) + '</span><span class="g">' + esc(it.group || '') + '</span>'
+    + (it.detail ? '<span class="d">' + esc(it.detail) + '</span>' : '')
+    + (it.key ? '<kbd>' + esc(it.key) + '</kbd>' : '') + '</div>').join('');
+  m.querySelectorAll('.row').forEach(r => r.addEventListener('click', () => run(items[+r.dataset.i])));
+  m.querySelector('.row.on')?.scrollIntoView({ block: 'nearest' });
+}
+function run(it) {
+  if (!it) return;
+  if (tab === 'files') window.mazz.invoke('panel:action', { type: 'quickopenRun', path: it.path }).catch(() => {});
+  else window.mazz.invoke('panel:action', { type: 'paletteRun', id: it.id }).catch(() => {});
+  window.mazz.invoke('panel:close', { kind: 'palette' }).catch(() => {});
+}
+$('#q').addEventListener('input', () => { sel = 0; ask(); });
+$('#q').addEventListener('keydown', (e) => {
+  if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(items.length - 1, sel + 1); render(); }
+  else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); render(); }
+  else if (e.key === 'Enter') { e.preventDefault(); run(items[sel]); }
+  else if (e.key === 'Escape') pwb('close');
+});
+window.mazz.on('panel:push', (p) => {
+  if (p?.type === 'paletteInit' && p.tab) { setTab(p.tab); return; }
+  if (!p?.items) return;
+  items = p.items;
+  if (sel >= items.length) sel = Math.max(0, items.length - 1);
+  render();
+});
+ask();
+</script></body></html>
diff --git a/renderer/panels/panel-shared.css b/renderer/panels/panel-shared.css
new file mode 100644
index 0000000..80e22d7
--- /dev/null
+++ b/renderer/panels/panel-shared.css
@@ -0,0 +1,26 @@
+/* renderer/panels/panel-shared.css —— 面板窗共享样式（军规④溢出必滚动条：所有子窗统一链接，禁静默裁切）
+ * 滚动条族与主界面 .mazz-scroll 同款视觉（7px 细轨/fg-dim 45% 滑块/hover 加深） */
+
+/* 全局滚动条族：面板窗内一切溢出元素统一细滚动条（只 themes.css+本件，base.css 面板窗不加载） */
+*::-webkit-scrollbar { width: 7px; height: 7px; }
+*::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--fg-dim) 45%, transparent); border-radius: 4px; }
+*::-webkit-scrollbar-thumb:hover { background: var(--fg-dim); }
+*::-webkit-scrollbar-track { background: transparent; }
+*::-webkit-scrollbar-corner { background: transparent; }
+
+/* 滚动容器工具类：超框即滚（min-height:0 是 flex 子级滚动的生死线） */
+.ps-scroll { overflow: auto; min-height: 0; scrollbar-width: thin; }
+.ps-scroll-y { overflow-y: auto; overflow-x: hidden; min-height: 0; scrollbar-width: thin; }
+
+
+/* —— W55 迁移前 modal 控件族原值（与 base.css rb 族同值——独立子窗格与迁移前样式统一） —— */
+.rb-input, .rb-select { background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 6px; padding: 4px 8px; font-size: 12px; font-family: var(--font-ui); }
+.rb-input:focus, .rb-select:focus { border-color: var(--accent); outline: none; }
+.rb-btn { border: 0; background: transparent; color: var(--fg); cursor: pointer; border-radius: 6px; padding: 6px 8px; font-size: 12px; display: inline-flex; align-items: center; gap: 5px; min-width: 40px; font-family: var(--font-ui); }
+.rb-btn:hover:not(:disabled) { background: var(--bg-hover); }
+.rb-btn:active:not(:disabled), .rb-btn.on { background: var(--accent-soft); color: var(--accent); }
+.rb-btn:disabled { opacity: .38; cursor: default; }
+.set-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 7px 0; font-size: 12.5px; }
+
+/* 文本截断提示：裁切必须带省略号，不许生吞 */
+.ps-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
diff --git a/renderer/panels/plugins.html b/renderer/panels/plugins.html
new file mode 100644
index 0000000..66fc806
--- /dev/null
+++ b/renderer/panels/plugins.html
@@ -0,0 +1,91 @@
+<!DOCTYPE html>
+<html lang="zh-CN"><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'">
+<title>插件管理</title>
+<link rel="stylesheet" href="../styles/themes.css">
+<link rel="stylesheet" href="panel-shared.css">
+<style>
+  html, body { background: transparent; }
+  * { box-sizing: border-box; }
+  body { margin:0; font:13px/1.5 var(--font-ui); }
+  .pwin { display:flex; flex-direction:column; height:100vh; background:var(--bg); color:var(--fg); border-radius:12px; overflow:hidden; border:1px solid var(--border); box-shadow:0 10px 36px rgba(0,0,0,.4); }
+  .p-drag { height:12px; flex:none; -webkit-app-region:drag; }
+  .p-winbtns { position:absolute; top:2px; right:8px; display:flex; gap:2px; z-index:9; }
+  .p-winbtns button { display:inline-flex; align-items:center; justify-content:center; -webkit-app-region:no-drag; width:30px; height:22px; border:0; border-radius:6px; background:transparent; color:var(--fg-dim); cursor:pointer; font-size:12px; }
+  .p-winbtns button:hover { background:var(--bg-hover); color:var(--fg); }
+  .p-winbtns button.x:hover { background:#e81123; color:#fff; }
+  .head { display:flex; align-items:center; gap:8px; padding:10px 16px; border-bottom:1px solid var(--border); background:var(--bg-elev); flex:none; }
+  .head .t { font-size:15px; font-weight:600; flex:1; }
+  .btn { border:1px solid var(--border); background:var(--bg); color:var(--fg); border-radius:6px; padding:6px 8px; font-size:12px; cursor:pointer; font-family:var(--font-ui); display:inline-flex; align-items:center; gap:4px; }
+  .btn:hover { border-color:var(--accent); color:var(--accent); }
+  .btn:disabled { opacity:.4; cursor:default; }
+  .head .note { font-size:11px; color:var(--fg-dim); }
+  main { flex:1; min-height:0; padding:10px 16px; overflow-y:auto; }
+  .plg { display:flex; align-items:center; gap:10px; padding:9px 6px; border-bottom:1px solid var(--border); }
+  .plg .ico { font-size:20px; width:26px; text-align:center; flex:none; }
+  .plg .info { flex:1; min-width:0; }
+  .plg .name { font-weight:600; font-size:13px; }
+  .plg .name small { color:var(--fg-dim); font-weight:400; }
+  .plg .desc { font-size:11.5px; color:var(--fg-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+  .plg .desc.err { color:#c2410c; }
+  .empty { color:var(--fg-dim); text-align:center; padding:40px 0; line-height:2; }
+</style></head><body>
+<div class="pwin">
+  <div class="p-drag"></div>
+  <div class="p-winbtns"><button id="p-min" title="最小化"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg></button><button id="p-max" title="最大化/还原"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="1.5"/></svg></button><button class="x" id="p-close" title="关闭"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
+  <div class="head">
+    <span class="t">插件管理</span>
+    <span class="note">.maz = zip 包（plugin.json + main.js）</span>
+    <button class="btn" id="install">＋ 安装插件</button>
+  </div>
+  <main id="m" class="ps-scroll-y"><div class="empty">加载中…</div></main>
+</div>
+<script>
+const $ = (s) => document.querySelector(s);
+const pwb = (a) => window.mazz.invoke('window:' + a).catch(() => {});
+$('#p-min').addEventListener('click', () => pwb('minimize'));
+$('#p-max').addEventListener('click', () => pwb('toggleMaximize'));
+$('#p-close').addEventListener('click', () => pwb('close'));
+const applyTheme = (id) => { if (id) document.documentElement.dataset.theme = id; };
+window.mazz.invoke('settings:get', { key: 'theme' }).then(t => applyTheme(typeof t === 'string' ? t : t?.id)).catch(() => {});
+window.mazz.on('theme:changed', ({ id }) => applyTheme(id));
+const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
+
+let rows = [];
+function ask() { window.mazz.invoke('panel:action', { type: 'pluginsQuery' }).catch(() => {}); }
+function act(actName, extra = {}) { window.mazz.invoke('panel:action', { type: 'pluginsAction', act: actName, ...extra }).catch(() => {}); }
+
+function render() {
+  const m = $('#m');
+  if (!rows.length) {
+    m.innerHTML = '<div class="empty">还没有安装插件——点「安装插件」选择 .maz 文件<br><small>交付包 samples/ 目录自带两个示例插件</small></div>';
+    return;
+  }
+  m.innerHTML = rows.map((r, i) => `
+    <div class="plg" data-i="${i}">
+      <span class="ico">${r.error ? '⚠' : '🧩'}</span>
+      <div class="info">
+        <div class="name">${esc(r.name)} <small>v${esc(r.version)}</small></div>
+        <div class="desc${r.error ? ' err' : ''}">${esc(r.error || r.desc || r.id)}</div>
+      </div>
+      ${r.error ? '' : `
+        <button class="btn" data-a="open" ${r.enabled ? '' : 'disabled'}>打开</button>
+        <button class="btn" data-a="toggle">${r.enabled ? '禁用' : '启用'}</button>`}
+      <button class="btn" data-a="del">删除</button>
+    </div>`).join('');
+  m.querySelectorAll('.plg button').forEach(b => b.addEventListener('click', () => {
+    const r = rows[+b.closest('.plg').dataset.i];
+    if (!r) return;
+    act(b.dataset.a, { id: r.id, path: r.path, enabled: r.enabled, name: r.name });
+  }));
+}
+window.mazz.on('panel:push', (p) => {
+  if (p?.type !== 'plugins') return;
+  rows = p.rows || [];
+  render();
+});
+$('#install').addEventListener('click', () => act('install'));
+document.addEventListener('keydown', (e) => { if (e.key === 'Escape') pwb('close'); });
+ask();
+</script>
+</body></html>
diff --git a/renderer/panels/pwmgr.html b/renderer/panels/pwmgr.html
