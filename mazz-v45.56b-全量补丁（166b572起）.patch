+// tests/e2e/scenes35.mjs —— 波次四十四「播放器与媒体库已知问题专修」实证批
+// 空起手裸播放器 / 媒体库递归树（嵌套全检+折叠） / 下载目录明面化迁移 / 缩略图切源失效 / 保存路径明白话
+import fs from 'fs';
+import path from 'path';
