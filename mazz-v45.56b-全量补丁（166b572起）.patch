+/** 物料克隆（W38 页库复制）：深拷贝+页/Item 全换新 id（防跨页 id 撞车） */
+export function cloneSlide(src) {
+  const cp = JSON.parse(JSON.stringify(src));
+  cp.id = nid('s');
+  for (const it of (cp.items || [])) it.id = nid('it');
+  return cp;
+}
