+      await win.screenshot({ path: `${OUT}/w52e-主页刷新实证.png` }).catch(() => {});
+    });
+
+    // ==================== 2：devtools toggle + 主题跟随实证 ====================
+    await scenario('devtools·toggle与主题跟随', async () => {
