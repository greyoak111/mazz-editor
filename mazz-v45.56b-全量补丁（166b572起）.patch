+      // 关 modal（摘探针） → 恢复
+      await evaluate(() => document.getElementById('__cloakProbe')?.remove());
+      await human.until(() => window.__activeBrowserCtl?._cloaked === false, { timeout: 6000, msg: 'modal 关必须恢复' });
