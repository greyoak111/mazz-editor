+describe('lean 体系全体退役', () => {
+  test('五处绝迹', () => {
+    assert.ok(!readSrc('renderer/shell/shell.js').includes('openChildModal'), 'openChildModal 绝迹');
+    assert.ok(!readSrc('renderer/shell/shell.js').includes('snapshot?.openModal'), 'openModal 支路绝迹');
