+      await human.assert(anSize.cv, '墨迹画布必须在');
+      await human.assert(Math.abs(anSize.w - mainB.w) < 40 && Math.abs(anSize.h - mainB.h) < 40, `bounds 必须跟主窗（${JSON.stringify(anSize)} vs ${JSON.stringify(mainB)}——纹身级贴合）`);
