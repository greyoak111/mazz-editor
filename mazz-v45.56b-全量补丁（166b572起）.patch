+        }, { timeout: 15000, msg: 'AI 拆段成档' });
+      } catch (e) {
+        const diag = await evaluate(async () => {
+          const toasts = [...document.querySelectorAll('.mazz-toast, [class*=toast]')].map(t => t.textContent).slice(-3);
+          let chatProbe = null;
