+// tests/e2e/scenes45.mjs —— W52e 实证批
+// ①主页刷新不白屏（bv:js 文档探针硬指标） ②devtools toggle+主题跟随实证（uiTheme 真断言，摆烂平反） ③截图验收
+import fs from 'fs';
