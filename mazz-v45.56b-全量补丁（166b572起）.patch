+    // 数据桥：空检索 → 全量清单回推
+    const r0 = await palWin.evaluate(() => document.querySelectorAll('#m .row').length);
+    await human.assert(r0 >= 50, `空检索必须回推满 50 条（${r0}）`);
+    // 检索过滤：输「分屏」→ 必须命中
+    await palWin.fill('#q', '分屏');
+    await wait(500);
+    const r = await palWin.evaluate(() => ({
