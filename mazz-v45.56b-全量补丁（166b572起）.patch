+  if (r.b64) fs.writeFileSync(`/mnt/agents/output/probe-home-${label}.png`, Buffer.from(r.b64, 'base64'));
+  return r.len;
+};
+
+await probe('主页打开');
+await human.evaluate(() => window.MazzCommands?.execute('browser.navReload'));
