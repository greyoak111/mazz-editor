+for (let i = 0; i < 30; i++) {
+  await win.waitForTimeout(300);
+  dtWin = app.windows().find(w => w.url().startsWith('devtools://')) || null;
+  if (dtWin) break;
+}
+if (!dtWin) { console.log('FATAL: devtools 未开'); process.exit(1); }
