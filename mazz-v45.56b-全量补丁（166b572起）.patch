+        if (t) window.mazz.invoke('bv:devtools', { tabId: t.viewId }).catch(() => {});
+      });
+      let dtWin = null;
+      for (let i = 0; i < 30; i++) {
+        await wait(300);
+        dtWin = app.windows().find(w => w.url().startsWith('devtools://')) || null;
