+{
+  const dz = document.querySelector('.p-drag');
+  dz.addEventListener('pointerdown', (e) => {
+    if (e.target.closest('button')) return;
+    e.preventDefault();
+    try { dz.setPointerCapture(e.pointerId); } catch {}
+    window.mazz.invoke('panel:dragStart', { kind: 'dockfloat', sx: e.screenX, sy: e.screenY }).catch(() => {});
