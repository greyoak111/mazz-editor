+  .toc { flex:1; min-height:0; overflow-y:auto; padding:8px; }
+  .toc-item { padding:8px 10px; border-radius:8px; cursor:pointer; font-size:12.5px; line-height:1.4; }
+  .toc-item:hover { background:var(--bg-hover); }
