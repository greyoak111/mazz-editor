+      human.log('导图样式条:', JSON.stringify(st));
+      await human.assert(st.total >= 3, `样式条 select 必须在（实拿 ${st.total}）`);
+      await human.assert(st.hidden === st.total && st.btns >= st.total, `样式条 select 必须全收编（实拿 ${JSON.stringify(st)}）`);
